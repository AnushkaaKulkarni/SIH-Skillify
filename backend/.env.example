# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=YOUR_NEW_MONGODB_ATLAS_CONNECTION_STRING
DB_NAME=skillify_sih

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=1d

# Google Gemini AI API Keys
GRIEVANCES_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ORAL_API_KEY=your-gemini-oral-api-key-here
GEMINI_EXTENSION_TUTOR_API_KEY=your-gemini-tutor-api-key-here
GEMINI_INTERVIEW_API_KEY=your-gemini-interview-api-key-here
MENTOR_API_KEY=your-gemini-mentor-api-key-here
CODING_QUESTIONS_API_KEY=your-gemini-coding-api-key-here
SKILLIFY_AI_EXAM_KEY=your-gemini-exam-api-key-here

# External Search (Courses and code analysis)
SERP_API_KEY=your-serp-api-key-here

# External AI provider
AI_EXTERNAL_PROVIDER=gemini

# Optional administration and blockchain tools
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-admin-password
BLOCKCHAIN_PRIVATE_KEY=replace-with-blockchain-private-key
CONTRACT_ADDRESS=replace-with-contract-address

# AI Model Configuration
GRIEVANCE_AI_MODEL=gemini-2.5-flash
ORAL_AI_MODEL=gemini-2.5-flash
AI_PRIVATE_PROVIDER=ollama
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=replace-with-model-id-from-lm-studio

# Ollama Configuration (Primary for SIH)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m
GEMINI_FALLBACK_ENABLED=false

# Cloudinary (For file uploads in grievances)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@skillifyai.com
EMAIL_PASSWORD=your-app-password
EMAIL_SERVICE=gmail

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000

# Grievance System Configuration
GRIEVANCE_ESCALATION_HOURS_24=24
GRIEVANCE_ESCALATION_HOURS_48=48
GRIEVANCE_AI_MODEL=gemini-2.5-flash

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,txt,csv,xlsx

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
